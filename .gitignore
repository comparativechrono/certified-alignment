# Local builds and Python caches
build/
**/build/
__pycache__/
*.py[cod]
*.o
*.a
*.so
cc*.s

# Reproductions are kept separate from the committed published runs.
results/*reproduction*/

# Dependencies are fetched at pinned commits by the benchmark build script.
external_deps/
.external-deps/

# Restored large historical outputs; gzip copies are committed.
/results/benchmark/raw_results.json
/results/bound_benchmark/raw_results.json
/results/bound_benchmark/raw_results.csv
/results/bound_benchmark/summary.json
/results/ordered_benchmark/raw_results.json
/results/ordered_benchmark/raw_results.csv
/results/ordered_benchmark/summary.json
/results/sparse_benchmark/raw_results.json
/results/sparse_benchmark/raw_results.csv
/results/sparse_benchmark/summary.json
/results/repeat_benchmark/raw_results.json
/results/repeat_benchmark/raw_results.csv
/results/repeat_benchmark/summary.json

# Ephemeral external validation and shuffled batch inputs
external-adapter-test-*/
/results/external_benchmark/order-*.tsv
